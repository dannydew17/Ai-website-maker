# SQLite DB file used by Prisma (local to this sandbox; resets if the container is reclaimed)
DATABASE_URL="file:./dev.db"

# Required starting at Phase 4 (site copy + email draft generation)
ANTHROPIC_API_KEY=

# Required starting at Phase 5 (deploying generated sites)
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Required starting at Phase 7 (outreach email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# CAN-SPAM requires a real physical mailing address in every outreach email footer.
# Outreach send refuses to run if this is unset.
OUTREACH_PHYSICAL_ADDRESS=

# Base URL of the locally-run dashboard, used to build the one-click unsubscribe link
DASHBOARD_BASE_URL="http://localhost:3000"

# When true (default), outreach logs the would-be send instead of calling SendGrid.
# Only set to false after manually verifying the full chain end-to-end.
DRY_RUN_OUTREACH=true

# Overpass API instance used for discovery (no API key needed for the public instance)
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
